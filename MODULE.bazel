module(name = "ps_monorepo")

bazel_dep(name = "catch2", version = "3.12.0")
bazel_dep(name = "eigen", version = "5.0.1")
bazel_dep(name = "grpc", version = "1.80.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_qt", version = "0.0.6")
bazel_dep(name = "simdjson", version = "4.6.0")
bazel_dep(name = "spdlog", version = "1.17.0")
bazel_dep(name = "sqlite3", version = "3.51.2")

qt = use_extension("@rules_qt//extension:qt.bzl", "fetch")
qt.install(
    name = "qt_mac_aarch64",
    build_file = "@rules_qt//extension:qt/6.8.3/mac_aarch64.BUILD",
    os = "macos",
    version = "6.8.3",
)
use_repo(qt, "qt_mac_aarch64")

register_toolchains(
    "@rules_qt//tools:all",
)
