load("@rules_cc//cc:cc_test.bzl", "cc_test")

filegroup(
    name = "data",
    srcs = glob(["data/*"]),
)

cc_test(
    name = "base64_test",
    size = "small",
    srcs = ["base64_test.cpp"],
    deps = [
        "//utils:base64",
        "@catch2//:catch2_main",
    ],
)

cc_test(
    name = "sqlite_test",
    size = "small",
    srcs = ["sqlite_test.cpp"],
    data = ["data"],
    deps = [
        "//utils:sqlite",
        "@catch2//:catch2_main",
    ],
)
